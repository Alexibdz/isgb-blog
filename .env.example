# Local: no hace falta tocar nada, usa un archivo SQLite en la raíz del proyecto.
# DATABASE_URI=file:./isgb.db

# Cuando pasemos a Postgres/Supabase, esta misma variable pasa a ser la connection
# string de Postgres (y el adaptador en src/payload.config.ts cambia de
# sqliteAdapter a postgresAdapter):
# DATABASE_URI=postgresql://usuario:password@host:5432/postgres

# Cualquier string largo y secreto. Genéralo una sola vez y no lo cambies
# (invalida las sesiones activas del panel de admin).
PAYLOAD_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
